  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json",
    "tauri": "tauri",
    "test": "bun test ./src",
    "build:e2e": "cd src-tauri && cargo build",
    "test:e2e": "bun test --timeout 60000 ./e2e",
    "test:e2e:hiden": "GDK_BACKEND=x11 xvfb-run -a bun run test:e2e",
    "test:e2e:embedded:x11": "Xephyr :100 -screen 1030x1860 -resizeable",
    "test:e2e:embedded:run": "GDK_BACKEND=x11 DISPLAY=:100 bun run test:e2e",
    "test:e2e:quick": "bun e2e/quick.ts"
  },
