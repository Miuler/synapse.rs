{
  // Tipos de archivos soportados clasificados por categoría
  "supported_files": {
    // Formatos de imágenes soportadas
    "images": [
      "png",
      "webp",
      "jpg",
      "jpeg",
      "gif",
      "bmp",
      "svg",
      "ico",
      "avif",
      "tiff",
      "tif"
    ],

    // Notas Markdown (indexadas y renderizadas con soporte de edición/lectura)
    "markdown": [
      "md",
      "markdown"
    ],

    // Diagramas Mermaid y D2
    "diagrams": [
      "mmd",
      "mermaid",
      "d2"
    ],

    // Dibujos y bocetos Excalidraw
    "drawings": [
      "excalidraw",
      "excalidraw.json",
      "excalidraw.svg",
      "excalidraw.png",
      "excalidraw.md",
      "excalidraw.excalidraw"
    ],

    // Documentos PDF
    "pdf": [
      "pdf"
    ],

    // Documentos Microsoft Word
    "word": [
      "docx",
      "doc",
      "docm",
      "dot",
      "dotx"
    ],

    // Hojas de cálculo Microsoft Excel
    "excel": [
      "xlsx",
      "xls",
      "xlsm",
      "xlt",
      "xltx"
    ],

    // Código fuente y texto estructurado
    "code": [
      "txt",
      "rs",
      "ts",
      "js",
      "json",
      "toml",
      "yaml",
      "yml",
      "css",
      "html",
      "csv",
      "cbl",
      "cob"
    ]
  },

  // Configuración general del editor y guardado
  "editor": {
    // Guardado automático tras modificar notas, diagramas o lienzos Excalidraw (true | false)
    "auto_save": true,
    // Tiempo de inactividad (en milisegundos) sin eventos de escritura antes de persistir cambios automáticos.
    // Además se guarda de inmediato al perder el foco la ventana, cambiar de pestaña o pasar a solo lectura
    // (siempre respetando la regla de archivo bloqueado)
    "auto_save_delay_ms": 4000,
    // Tiempo de espera (en milisegundos) de inactividad antes de persistir dibujos Excalidraw a disco
    "drawing_auto_save_delay_ms": 3000,
    // Tiempo de espera (en milisegundos) para propagar cambios de escena en Excalidraw hacia la pestaña
    "drawing_change_debounce_ms": 400,
    // Ventana de gracia (en milisegundos) para ignorar eventos del watcher originados por guardados propios
    "fs_watcher_recent_save_grace_ms": 8000,
    // Tiempo de espera (en milisegundos) para agrupar refrescos de estado Git tras guardar (evita un `git status` por guardado)
    "git_status_refresh_debounce_ms": 5000
  },

  // Configuración de visualización y límites de diferencias Git (Diff Viewer)
  "diff": {
    // Número máximo de líneas en un archivo para expandir automáticamente todo el diff de texto
    // Si el archivo supera este límite (ej. dibujos Excalidraw o JSON extensos), solo se muestran los bloques modificados (hunks) para prevenir congelamientos
    "max_expand_lines": 800
  },

  // Configuración de límites y parámetros para la indexación de búsqueda Full-Text (Tantivy)
  "indexing": {
    // Tamaño máximo de archivo PDF a procesar en bytes (30 MB por defecto)
    "max_pdf_file_size": 31457280,
    // Máximo número de páginas de un PDF a extraer para indexación (evita procesar libros de miles de páginas)
    "max_pdf_pages": 80,
    // Tamaño máximo de archivo Word (.docx) a procesar en bytes (15 MB por defecto)
    "max_docx_file_size": 15728640,
    // Límite de caracteres de texto extraído a indexar en Tantivy (evita inflar el índice y protege memoria)
    "max_extracted_chars": 200000,
    // Longitud máxima permitida para una palabra individual antes de descartarla como basura o hash
    "max_word_length": 80,
    // Tiempo de inactividad (en milisegundos) del vault antes de lanzar un lote de reindexación Full-Text
    "debounce_ms": 5000
  },

  // Reglas de exclusión para ignorar dependencias, temporales y carpetas del sistema
  "ignored": {
    // Carpetas que deben ser completamente ignoradas y nunca recorridas
    "directories": [
      "node_modules",
      "target",
      "dist",
      "build",
      "out",
      "coverage",
      "vendor",
      "bin",
      "obj",
      "bower_components",
      "__pycache__",
      ".git",
      ".synapse",
      ".idea",
      ".vscode",
      ".obsidian",
      ".trash",
      ".cache",
      "cache"
    ],

    // Sufijos y extensiones de archivos temporales, copias de seguridad o de bloqueo
    "suffixes": [
      "~",
      ".tmp",
      ".temp",
      ".swp",
      ".swo",
      ".bak",
      ".lock",
      ".part",
      ".crdownload"
    ],

    // Prefijos de archivos temporales de editores
    "prefixes": [
      "#",
      ".#"
    ],

    // Nombres exactos de archivos que se deben ignorar
    "files": [
      "thumbs.db",
      ".ds_store"
    ]
  },

  // Configuración global de atajos de teclado (Shortcuts)
  // Puedes personalizar cualquier atajo desde ~/.config/synapsers/shortcuts.jsonc
  "shortcuts": {
    // Atajos de la Pantalla de Bienvenida (Workspaces Recientes)
    "welcome": {
      // Crear un nuevo directorio de Workspace
      "new_workspace": "Ctrl+Shift+N",
      // Abrir carpeta local existente como Workspace
      "open_folder": "Ctrl+Shift+O",
      // Clonar un repositorio Git como Workspace
      "clone_git": "Ctrl+Shift+G",
      // Enfocar el buscador de Workspaces recientes
      "search_workspaces": "Ctrl+F"
    },

    // Atajos del Espacio de Trabajo y Editor
    "workspace": {
      // Buscar y abrir archivo rápidamente por nombre (Quick Open)
      "quick_open": "Ctrl+O",
      // Abrir la paleta de comandos
      "command_palette": "Ctrl+P",
      // Crear nueva nota Markdown en la bóveda activa
      "new_file": "Ctrl+N",
      // Abrir una nueva pestaña vacía
      "new_tab": "Ctrl+T",
      // Guardar / Grabar el archivo activo
      "save_file": "Ctrl+S",
      // Cerrar la pestaña activa
      "close_tab": "Ctrl+W, Ctrl+F4",
      // Dividir el panel verticalmente (Split View)
      "split_view": "Ctrl+\\",
      // Mostrar u ocultar el explorador lateral de archivos
      "toggle_sidebar": "Alt+1, Ctrl+B",
      // Ubicar el archivo activo en el árbol del explorador
      "locate_active_file": "Ctrl+Alt+1, Alt+L",
      // Buscar en el contenido de las notas (Full-Text Search)
      "search_fulltext": "Ctrl+Shift+F",
      // Abrir otra carpeta o bóveda
      "open_vault_folder": "Ctrl+Shift+O",
      // Recargar el archivo activo desde el disco
      "reload_active_file": "Ctrl+R",
      // Recargar toda la bóveda y sus metadatos
      "reload_vault": "Ctrl+Shift+R",
      // Navegar atrás en el historial de pestañas
      "nav_back": "Alt+ArrowLeft",
      // Navegar adelante en el historial de pestañas
      "nav_forward": "Alt+ArrowRight",
      // Alternar entre tema Claro y Oscuro
      "toggle_theme": "Ctrl+Shift+T",
      // Abrir o cerrar herramientas de desarrollo (DevTools)
      "toggle_devtools": "F12, Ctrl+Shift+I",
      // Alternar entre modo Edición y modo Lectura de la nota activa
      "toggle_edit_mode": "Ctrl+E",
      // Enviar commits locales al repositorio remoto (Git Push)
      "git_push": "Ctrl+Shift+K"
    }
  }
}
