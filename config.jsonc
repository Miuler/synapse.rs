{
  // Tipos de archivos soportados clasificados por categoría
  "supported_files": {
    // Formatos de imágenes soportadas
    "images": [
      "png",
      "webp",
      "jpg",
      "jpeg",
      "gif",
      "bmp",
      "svg",
      "ico",
      "avif",
      "tiff",
      "tif"
    ],

    // Notas Markdown (indexadas y renderizadas con soporte de edición/lectura)
    "markdown": [
      "md",
      "markdown"
    ],

    // Diagramas Mermaid
    "diagrams": [
      "mmd",
      "mermaid"
    ],

    // Dibujos y bocetos Excalidraw
    "drawings": [
      "excalidraw",
      "excalidraw.json",
      "excalidraw.svg",
      "excalidraw.png",
      "excalidraw.md",
      "excalidraw.excalidraw"
    ],

    // Documentos PDF
    "pdf": [
      "pdf"
    ],

    // Código fuente y texto estructurado
    "code": [
      "rs",
      "ts",
      "js",
      "json",
      "toml",
      "yaml",
      "yml",
      "css",
      "html",
      "csv",
      "cbl",
      "cob"
    ]
  },

  // Configuración general del editor y guardado
  "editor": {
    // Guardado automático tras modificar notas, diagramas o lienzos Excalidraw (true | false)
    "auto_save": true,
    // Tiempo de espera (en milisegundos) antes de persistir cambios automáticos
    "auto_save_delay_ms": 600
  },

  // Reglas de exclusión para ignorar dependencias, temporales y carpetas del sistema
  "ignored": {
    // Carpetas que deben ser completamente ignoradas y nunca recorridas
    "directories": [
      "node_modules",
      "target",
      "dist",
      "build",
      "out",
      "coverage",
      "vendor",
      "bin",
      "obj",
      "bower_components",
      "__pycache__",
      ".git",
      ".synapse",
      ".idea",
      ".vscode",
      ".obsidian",
      ".trash",
      ".cache",
      "cache"
    ],

    // Sufijos y extensiones de archivos temporales, copias de seguridad o de bloqueo
    "suffixes": [
      "~",
      ".tmp",
      ".temp",
      ".swp",
      ".swo",
      ".bak",
      ".lock",
      ".part",
      ".crdownload"
    ],

    // Prefijos de archivos temporales de editores
    "prefixes": [
      "#",
      ".#"
    ],

    // Nombres exactos de archivos que se deben ignorar
    "files": [
      "thumbs.db",
      ".ds_store"
    ]
  },

  // Configuración global de atajos de teclado (Shortcuts)
  // Puedes personalizar cualquier atajo desde ~/.config/synapsers/shortcuts.jsonc
  "shortcuts": {
    // Atajos de la Pantalla de Bienvenida (Workspaces Recientes)
    "welcome": {
      // Crear un nuevo directorio de Workspace
      "new_workspace": "Ctrl+Shift+N",
      // Abrir carpeta local existente como Workspace
      "open_folder": "Ctrl+Shift+O",
      // Clonar un repositorio Git como Workspace
      "clone_git": "Ctrl+Shift+G",
      // Enfocar el buscador de Workspaces recientes
      "search_workspaces": "Ctrl+F"
    },

    // Atajos del Espacio de Trabajo y Editor
    "workspace": {
      // Buscar y abrir archivo rápidamente por nombre (Quick Open)
      "quick_open": "Ctrl+O",
      // Abrir la paleta de comandos
      "command_palette": "Ctrl+P",
      // Crear nueva nota Markdown en la bóveda activa
      "new_file": "Ctrl+N",
      // Abrir una nueva pestaña vacía
      "new_tab": "Ctrl+T",
      // Guardar / Grabar el archivo activo
      "save_file": "Ctrl+S",
      // Cerrar la pestaña activa
      "close_tab": "Ctrl+W, Ctrl+F4",
      // Dividir el panel verticalmente (Split View)
      "split_view": "Ctrl+\\",
      // Mostrar u ocultar el explorador lateral de archivos
      "toggle_sidebar": "Alt+1, Ctrl+B",
      // Ubicar el archivo activo en el árbol del explorador
      "locate_active_file": "Ctrl+Alt+1, Alt+L",
      // Buscar en el contenido de las notas (Full-Text Search)
      "search_fulltext": "Ctrl+Shift+F",
      // Abrir otra carpeta o bóveda
      "open_vault_folder": "Ctrl+Shift+O",
      // Recargar el archivo activo desde el disco
      "reload_active_file": "Ctrl+R",
      // Recargar toda la bóveda y sus metadatos
      "reload_vault": "Ctrl+Shift+R",
      // Navegar atrás en el historial de pestañas
      "nav_back": "Alt+ArrowLeft",
      // Navegar adelante en el historial de pestañas
      "nav_forward": "Alt+ArrowRight",
      // Alternar entre tema Claro y Oscuro
      "toggle_theme": "Ctrl+Shift+T",
      // Abrir o cerrar herramientas de desarrollo (DevTools)
      "toggle_devtools": "F12, Ctrl+Shift+I"
    }
  }
}
