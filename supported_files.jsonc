{
  // Formatos de imágenes soportadas
  "images": [
    "png",
    "webp",
    "jpg",
    "jpeg",
    "gif",
    "bmp",
    "svg",
    "ico",
    "avif",
    "tiff",
    "tif"
  ],

  // Notas Markdown (indexadas y renderizadas con soporte de edición/lectura)
  "markdown": [
    "md",
    "markdown"
  ],

  // Diagramas Mermaid
  "diagrams": [
    "mmd",
    "mermaid"
  ],

  // Dibujos y bocetos Excalidraw
  "drawings": [
    "excalidraw",
    "excalidraw.json",
    "excalidraw.svg",
    "excalidraw.png"
  ],

  // Código fuente y texto estructurado
  "code": [
    "rs",
    "ts",
    "js",
    "json",
    "toml",
    "yaml",
    "yml",
    "css",
    "html",
    "csv",
    "cbl",
    "cob"
  ]
}
