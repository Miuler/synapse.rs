{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "synapsers",
  "version": "0.1.0",
  "identifier": "com.miuler.synapse",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Synapse",
        "width": 1180,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**/*",
          "$HOME/**",
          "**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "cli": {
      "description": "Synapse - Modern extensible markdown note-taking and knowledge base",
      "args": [
        {
          "name": "vault",
          "short": "v",
          "description": "Ruta a la carpeta de la bóveda (vault) a abrir",
          "takesValue": true
        },
        {
          "name": "file",
          "short": "f",
          "description": "Ruta al archivo Markdown individual a abrir",
          "takesValue": true
        },
        {
          "name": "mcp",
          "description": "Inicia el servidor local MCP (Model Context Protocol) vía stdio para IA / LLMs",
          "takesValue": false
        },
        {
          "name": "path",
          "index": 1,
          "description": "Ruta posicional a un archivo o bóveda",
          "takesValue": true
        }
      ]
    }
  }
}
